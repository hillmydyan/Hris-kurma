# ========================================================
# CONTOH KONFIGURASI .ENV UNTUK DEPLOYMENT DOCKER (PRODUKSI)
# Salin isi file ini ke file `backend/.env` di VPS Anda
# ========================================================

APP_NAME="HRIS Kurma Group"
APP_ENV=production
APP_KEY=base64:GENERATE_DENGAN_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://hris.domainperusahaan.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Koneksi Database (mengarah ke service 'db' di docker-compose)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=hris_db
DB_USERNAME=hris_user
DB_PASSWORD=hris_secret_ganti_dengan_password_kuat
DB_ROOT_PASSWORD=root_secret_ganti_dengan_password_kuat

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Port yang dibuka di server
HRIS_PORT=8085
HRIS_DB_PORT=3307  # Port database lokal via SSH Tunnel

# Konfigurasi Mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@domainperusahaan.com"
MAIL_FROM_NAME="${APP_NAME}"
